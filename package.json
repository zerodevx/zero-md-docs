{
  "name": "zero-md-docs",
  "version": "2.0.0",
  "description": "Instantly publish markdown from Github docs folder",
  "author": "Jason Lee <jason@zerodevx.com>",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build && npm run build:transform && npx publint",
    "build:transform": "cd dist && rm index.html && mv assets/*.js index.js && mv assets/*.css styles.css && rmdir assets",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "type": "module",
  "exports": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "style": "./dist/styles.css",
  "files": [
    "dist"
  ],
  "license": "ISC",
  "repository": "github:zerodevx/zero-md-docs",
  "keywords": [
    "api-documentation-tool",
    "markdown-to-html",
    "zero-md"
  ]
}
